{
	"name": "ssowhat.dev",
	"private": true,
	"version": "0.3.0",
	"description": "Interactive SSO protocol demos — visualize SAML, OIDC, OAuth2, and more",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/onetimesecret/ssowhat.dev"
	},
	"packageManager": "pnpm@10.22.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host --port 5184",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:all": "pnpm run test && pnpm -r --if-present test",
		"mock:dev": "pnpm --filter @ssowhat/mock-server dev"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.56.6",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	}
}
